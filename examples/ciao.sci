# Lu compilatore che compila quann ie pare.
mitte nome "San Benedetto"
dicce "Oh, " piu nome

mitte eta 18
mitte maggiorenne eta piu uguale 18
dicce "Maggiorenne? " piu maggiorenne

mitte sincero sci
dicce sincero

dicce se eta piu uguale 18 e nome diverse "Luigi" po
    "Ie sincere"
altrimenti
    "Ne ie sincere"
firmete

quinde conta(n)
    dicce "Contatore " piu n
    tornete a se n piu de 0 po
        conta(n meno 1)
    altrimenti
        no
    firmete
firmete

conta(2)
