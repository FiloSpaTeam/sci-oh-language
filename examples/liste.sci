# Lista letterale
mitte numeri [1, 2, 3, 4, 5]
dicce numeri

# Lista vuota
mitte vuota []
dicce vute vuota
dicce vute numeri

# prime e uldeme
dicce prime numeri
dicce uldeme numeri

# mitta prime (cons)
mitte nuova 0 mitta prime numeri
dicce nuova

# Funzione ricorsiva su lista: somma
quinde somma(lista)
    tornete a se vute lista po
        0
    altrimenti
        prime lista piu somma(uldeme lista)
    firmete
firmete

dicce somma(numeri)

# Costruire una lista con cons
mitte costruita 1 mitta prime 2 mitta prime 3 mitta prime []
dicce costruita
