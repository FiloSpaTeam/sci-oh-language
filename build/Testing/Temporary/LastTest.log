    out << toText(value);
    return out;
}

} // namespace Scioh

int main() {
    try {
        Scioh::Value v0 = Scioh::Value("San Benedetto");
        std::cout << Scioh::add(Scioh::Value("Oh, "), v0) << '\n';
        v0 = Scioh::Value("sci-oh");
        std::cout << Scioh::add(Scioh::Value("Mo ie "), v0) << '\n';
        Scioh::Value v1 = Scioh::add(Scioh::Value(static_cast<double>(1)), Scioh::Value(static_cast<double>(1)));
        std::cout << Scioh::add(Scioh::Value("Une chiu une fa "), v1) << '\n';
        Scioh::Value v2 = Scioh::Value(static_cast<double>(18));
        Scioh::Value v3 = Scioh::ge(v2, Scioh::Value(static_cast<double>(18)));
        std::cout << Scioh::add(Scioh::Value("Maggiorenne? "), v3) << '\n';
        Scioh::Value v4 = Scioh::Value(true);
        std::cout << v4 << '\n';
        Scioh::Value v5 = Scioh::Value(false);
        if (Scioh::isTruthy(Scioh::logicAnd(Scioh::ge(v2, Scioh::Value(static_cast<double>(18))), Scioh::ne(v0, Scioh::Value("Luigi"))))) {
            std::cout << Scioh::Value("Ie sincere") << '\n';
        } else {
            std::cout << Scioh::Value("Ne ie sincere") << '\n';
        }
        if (Scioh::isTruthy(Scioh::logicNot(v5))) {
            std::cout << Scioh::Value("Ne ie stanche") << '\n';
        }
        Scioh::Value v6 = Scioh::Value(static_cast<double>(0));
        while (Scioh::isTruthy(Scioh::lt(v6, Scioh::Value(static_cast<double>(3))))) {
            std::cout << Scioh::add(Scioh::Value("Contatore "), v6) << '\n';
            v6 = Scioh::add(v6, Scioh::Value(static_cast<double>(1)));
        }
        return 0;
    } catch (const std::exception& error) {
        std::cerr << "errore runtime: " << error.what() << '\n';
        return 1;
    }
}
